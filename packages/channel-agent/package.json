{
  "name": "@anvia/channel-agent",
  "version": "0.2.0",
  "description": "Anvia agent integration for communication channels.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --target node24 --format esm --dts --sourcemap --clean && node scripts/fix-node-imports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anvia/core": "^1.0.9",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@anvia/channel": "workspace:*"
  },
  "peerDependencies": {
    "@anvia/core": "^1.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvia-hq/channels.git",
    "directory": "packages/channel-agent"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
