{
  "name": "@anvia/discord",
  "version": "0.1.1",
  "description": "Discord channel adapter for Anvia.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --target node24 --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@anvia/channel": "workspace:*",
    "discord.js": "^14.27.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvia-hq/channels.git",
    "directory": "packages/discord"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
