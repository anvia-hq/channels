{
  "name": "anvia-channels",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint",
    "check:fix": "pnpm lint:fix && pnpm format",
    "changeset": "changeset",
    "example:discord": "pnpm --filter @anvia/example-discord-agent start",
    "example:slack": "pnpm --filter @anvia/example-slack-agent start",
    "example:telegram": "pnpm --filter @anvia/example-telegram-agent start",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm -r --if-present test && node --test scripts/release-packages.test.mjs tooling/oxlint/anvia-plugin.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:release": "pnpm check && pnpm typecheck && pnpm build && pnpm test",
    "version-packages": "changeset version && pnpm format && pnpm install --lockfile-only && pnpm install --frozen-lockfile && pnpm check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "oxfmt": "0.70.0",
    "oxlint": "^1.85.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvia-hq/channels.git"
  }
}
